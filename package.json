{
  "name": "euler-theorem-prover",
  "version": "1.0.0",
  "description": "Euler Web Theorem Prover is a Prolog-powered symbolic proof system that explains how Euler\u2013Maclaurin reasoning connects sums, integrals, endpoint corrections, Bernoulli numbers, and closed-form formulas for powers. It is designed to be readable by children, students, and GitHub agents.",
  "main": "app.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "swipl -g \"['tests/test_linear.pl','tests/test_squares.pl','tests/test_cubes.pl','tests/test_shifted_polynomials.pl','tests/test_decimal_terms.pl','tests/test_stage2.pl','tests/test_stage3.pl','tests/test_stage4.pl','tests/test_stage5.pl','tests/test_stage6.pl','tests/test_stage7.pl','tests/test_stage8.pl','tests/test_stage9.pl','tests/test_stage10.pl'],run_tests,halt\"",
    "web": "python -m http.server 8000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciangreen/Euler-Theorem-Prover.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/luciangreen/Euler-Theorem-Prover/issues"
  },
  "homepage": "https://github.com/luciangreen/Euler-Theorem-Prover#readme"
}
